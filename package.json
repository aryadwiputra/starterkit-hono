{
  "name": "hono-starterkit",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run worker/index.ts",
    "dev:all": "bun run --bun \"bun run --watch src/index.ts\" \"bun run --watch worker/index.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1123.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "hono-zod-openapi": "^1.1.1",
    "ioredis": "^6.0.0",
    "nanoid": "^5.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.10"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
