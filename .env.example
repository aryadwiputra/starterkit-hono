# Environment Variables
# Copy to .env and fill in values

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_DIR=logs  # Log file directory (daily rotation, auto-delete > 7 days)

# Database
DATABASE_URL=file:./data.db

# Session
SESSION_EXPIRY_DAYS=7

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-password
# EMAIL_FROM=noreply@example.com

# S3 Storage (optional)
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000  # For MinIO
# S3_ACCESS_KEY=your-access-key
# S3_SECRET_KEY=your-secret-key
# S3_PUBLIC_URL=https://cdn.example.com  # Optional CDN URL

# Redis (required for queues)
# REDIS_URL=redis://localhost:6379
# REDIS_URL=redis://user:password@localhost:6379

# Resend Email (optional - for sending emails)
# Get API key from https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxx

# AWS S3 (optional - for Loki log archive)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=loki-logs
# S3_REGION=us-east-1
